DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"
# Optional: path to a Chrome binary for rendering (used with chrome-for-testing
# headless mode). Leave unset to let Remotion download chrome-headless-shell.
REMOTION_BROWSER_EXECUTABLE="/usr/bin/google-chrome"
